{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npx --yes pnpm@10.4.1 install --frozen-lockfile",
  "buildCommand": "npx --yes pnpm@10.4.1 build:vercel",
  "outputDirectory": "dist/public",
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api(/.*)?",
      "destination": "/api/index"
    },
    {
      "source": "/manus-storage/(.*)",
      "destination": "/api/manus-storage/$1"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/(students|parents|counselors|schools|privacy|terms|support|accessibility|resources|career-simulations)(/)?",
      "destination": "/$1/index.html"
    },
    {
      "source": "/resources/explore-careers-in-high-school(/)?",
      "destination": "/resources/explore-careers-in-high-school/index.html"
    },
    {
      "source": "/(auth(?:/update-password)?|onboarding|app(?:/[^/]+)?|share/[^/]+|portfolio/[^/]+)(/)?",
      "destination": "/app-shell.html"
    }
  ]
}
